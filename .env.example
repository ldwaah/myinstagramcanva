# App URL (marketing + dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tenant subdomain root. Without wildcard DNS, sites are served at {APP_URL}/site/{username}.
# With wildcard DNS + NEXT_PUBLIC_TENANT_SUBDOMAINS_ENABLED=true: https://{username}.{ROOT_DOMAIN}
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Production (Netlify or Vercel):
# NEXT_PUBLIC_APP_URL=https://myinstagramcanva.com
# NEXT_PUBLIC_ROOT_DOMAIN=myinstagramcanva.com
# Set after wildcard DNS (*.myinstagramcanva.com) and Netlify domain alias are configured:
# NEXT_PUBLIC_TENANT_SUBDOMAINS_ENABLED=true

# Database
# Local: SQLite file (default). Production: PostgreSQL — Neon, Supabase, or Netlify DB.
#   Neon (free): https://neon.tech → create project → copy connection string
#   Example prod: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Run once against prod: DATABASE_URL="postgresql://..." npm run db:push
# Path is relative to packages/db/prisma/schema.prisma (not the app cwd)
DATABASE_URL="file:./dev.db"

# Auth (required in production — used to sign session cookies)
NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://myinstagramcanva.com
NEXTAUTH_SECRET=change-me-to-a-random-secret-min-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_CREATOR=price_creator
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_STUDIO=price_studio
STRIPE_PRICE_AI_BYOK=price_ai_byok
STRIPE_PRICE_AI_MANAGED=price_ai_managed
STRIPE_PRICE_AI_TOPUP=price_ai_topup

# OpenAI (platform managed AI)
OPENAI_API_KEY=sk-...

# Encryption for BYOK keys
ENCRYPTION_KEY=32-byte-hex-key-change-in-production

# GitHub (central sites repo)
GITHUB_TOKEN=ghp_...
GITHUB_SITES_REPO=owner/myinstagramcanva-sites
GITHUB_SITES_BRANCH=main

# R2 / S3-compatible storage (optional; falls back to local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=myinstagramcanva
R2_PUBLIC_URL=

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@myinstagramcanva.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Affiliates (commission rate as decimal, e.g. 0.12 = 12%)
AFFILIATE_COMMISSION_RATE=0.12

# Cron (weekly IG sync for paid tiers)
CRON_SECRET=change-me

# Instagram server-side fetch (required on Netlify — datacenter IPs are blocked by Instagram)
# Direct fetch works locally; on Netlify set a residential proxy that forwards ?url=...
# Examples:
#   ScraperAPI: https://api.scraperapi.com?api_key=YOUR_KEY
#   Bright Data: https://brd.superproxy.io:22225 (with auth in URL if supported)
#   Cloudflare Worker: https://your-worker.workers.dev/fetch
INSTAGRAM_PROXY_URL=

# Admin
ADMIN_EMAILS=admin@myinstagramcanva.com

# Instagram OAuth (Phase 5)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Production: INSTAGRAM_REDIRECT_URI=https://myinstagramcanva.com/api/auth/instagram/callback
