# App URL (marketing site)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tenant subdomain root. Without wildcard DNS, sites are served at {APP_URL}/site/{username}.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://myinstagramcanva.com
# NEXT_PUBLIC_ROOT_DOMAIN=myinstagramcanva.com
# NEXT_PUBLIC_TENANT_SUBDOMAINS_ENABLED=true

# Database (PostgreSQL in production — Neon, Supabase, or Netlify DB)
DATABASE_URL="file:./dev.db"

# Auth (session cookies — required in production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret-min-32-chars

# Stripe — one-off website plans after 14-day trial (card required, not charged today)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_LAUNCH=price_launch_50
STRIPE_PRICE_CREATOR=price_creator_100
STRIPE_PRICE_BESPOKE=price_bespoke_300

# Optional: AI collaborator add-on (dashboard)
STRIPE_PRICE_AI_BYOK=price_ai_byok
STRIPE_PRICE_AI_MANAGED=price_ai_managed
STRIPE_PRICE_AI_TOPUP=price_ai_topup

# OpenAI (internal site building only — not customer-facing)
OPENAI_API_KEY=sk-...

# Encryption for BYOK keys
ENCRYPTION_KEY=32-byte-hex-key-change-in-production

# GitHub — publish site bundles
GITHUB_TOKEN=ghp_...
GITHUB_SITES_REPO=owner/myinstagramcanva-sites
GITHUB_SITES_BRANCH=main

# R2 / S3-compatible storage (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=myinstagramcanva
R2_PUBLIC_URL=

# Resend (request notifications and enquiry emails)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@myinstagramcanva.com

# Cron (example site seeding, trial expiry)
CRON_SECRET=change-me

# Instagram proxy (required on Netlify for server-side fetch)
INSTAGRAM_PROXY_URL=

# Admin
ADMIN_EMAILS=admin@myinstagramcanva.com
